{
  "name": "ghislain.dev",
  "private": true,
  "type": "module",
  "description": "ghislain.dev: the site, the Slidev decks (trainings and talks) and their shared Tokyo Night theme",
  "author": "Ghislain Gabriëlse",
  "scripts": {
    "site": "node scripts/build-site.mjs --serve",
    "build:site": "node scripts/build-site.mjs",
    "setup": "npm ci",
    "build": "npm run build:decks && node scripts/build-site.mjs",
    "build:decks": "npm run build --workspaces"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "decks/*"
  ]
}
